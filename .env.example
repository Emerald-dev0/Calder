# Avenor — Environment Variables
# Copy to .env and fill in values. Never commit secrets.

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# APP_URL=http://localhost:3000
# Founder emails (comma-separated) — auto-granted owner of the Avenor org on first OAuth login
# FOUNDER_EMAILS=you@example.com
# DASHBOARD_URL=http://localhost:3001
# API_URL=http://localhost:3002

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://avenor:avenor@localhost:5432/avenor

# ── Redis (queue / cache / rate-limit) ───────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────
# AUTH_SECRET must be 32+ characters in production
AUTH_SECRET=dev-secret-change-me-32-chars-min
# BETTER_AUTH_URL or AUTH_URL depending on auth provider
AUTH_URL=http://localhost:3001

# ── Email Provider (AWS SES) ─────────────────────────────────
# Required only when using real SES provider; mock works without these
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_FROM_DOMAIN=avenor.example.com

# ── Billing (Bachs) ──────────────────────────────────────────
# BACHS_API_KEY=
# BACHS_WEBHOOK_SECRET=
# BACHS_API_URL=https://api.bachs.example.com

# ── Admin (broadcasts, interventions — unset disables /v1/admin/*) ──
# ADMIN_API_KEY=use-openssl-rand-hex-32-min-16-chars

# ── Webhooks ─────────────────────────────────────────────────
WEBHOOK_SIGNING_SECRET=whsec_dev_secret_change_me

# ── Encryption ───────────────────────────────────────────────
# For future use: encrypting sensitive fields at rest
# ENCRYPTION_KEY=32-byte-hex-key
