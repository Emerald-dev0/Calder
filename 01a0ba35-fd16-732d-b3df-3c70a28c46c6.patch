+      attemptCount: 0,
+      providerMessageId: over.providerMessageId ?? `ses-${suffix}-${id}`,
+    });
+    emailIds.push(id);
+    return id;
+  }
+  const providerMessageIdOf = (id: string) => `ses-${suffix}-${id}`;
+
+  const savedTopics = process.env.SES_SNS_TOPIC_ARNS;
+
+  beforeAll(async () => {
+    if (!(await reachable())) return;
