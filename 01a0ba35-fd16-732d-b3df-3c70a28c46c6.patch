++        verifiedAt,
++        lastVerifyError: null,
++        verifyAttempts: attemptsAfter,
++        verifyWindowStart: windowStart,
++        updatedAt: now,
++      })
++      .where(and(eq(domains.id, row.id), eq(domains.projectId, projectId), ne(domains.status, "verified")))
