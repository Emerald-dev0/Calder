++import { and, eq, lt, ne } from "drizzle-orm";
++import { domains } from "./schema/domains.js";
++import type { getDb } from "./client.js";
++import {
++  CHALLENGE_TTL_MS,
++  VERIFY_RATE_LIMIT,
++  VERIFY_WINDOW_MS,
++  checkOwnership,
++  defaultTxtOracle,
++  expectedTxtHost,
++  expectedTxtValue,
++  newVerificationToken,
++  type TxtOracle,
