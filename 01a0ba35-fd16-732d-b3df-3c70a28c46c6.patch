++      verificationToken: token,
++      verificationExpiresAt: expiresAt,
++      status: "pending",
++      verifyAttempts: 0,
++      verifyWindowStart: null,
++      lastVerifyError: null,
++      updatedAt: new Date(),
++    })
++    .where(and(eq(domains.id, domainId), eq(domains.projectId, projectId)));
