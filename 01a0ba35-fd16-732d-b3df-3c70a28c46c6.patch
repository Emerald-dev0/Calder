++
++describe("registry SSRF guard (M3.1, write side)", () => {
++  it("denies private/loopback/metadata URLs at registration", () => {
++    for (const u of [
++      "http://127.0.0.1/hook",
++      "https://10.1.2.3/",
++      "https://192.168.0.10/",
++      "https://172.20.0.1/",
++      "http://localhost:8080/hook",
++      "https://169.254.0.9/",
++      "https://100.70.0.1/", // CGNAT
++      "https://255.255.255.255/",
