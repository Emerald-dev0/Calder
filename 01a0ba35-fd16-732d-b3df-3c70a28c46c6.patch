++  const expiresAt = new Date(Date.now() + CHALLENGE_TTL_MS);
++  await db.insert(domains).values({
++    id: input.id,
++    projectId: input.projectId,
++    domain,
++    status: "pending",
++    verificationMethod: "dns",
++    verificationToken: token,
++    verificationExpiresAt: expiresAt,
