++type Progress = "created" | "queued" | "sending" | "sent" | "delivered";
++const PROGRESS_RANK: Record<Progress, number> = {
++  created: 0,
++  queued: 1,
++  sending: 2,
++  sent: 3,
++  delivered: 4,
