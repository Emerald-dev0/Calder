+
+describe("structured API error shape", () => {
+  it("extracts message + code from { error: { code, message } }", async () => {
+    const { sdk } = clientWithMock(() =>
+      jsonResponse(422, { error: { code: "suppressed", message: "Recipient suppressed." } })
+    );
