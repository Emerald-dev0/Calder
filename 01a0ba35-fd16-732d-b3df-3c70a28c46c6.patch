++  // Dynamic segment fallback: replace concrete ids by [id]-style dirs.
++  const parts = seg.split("/");
++  for (const root of ["app/(app)", "app"]) {
++    let dir = join(APP_ROOT, root);
++    let ok = parts.length > 0 && !!parts[0];
++    for (const p of parts) {
