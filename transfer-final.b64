async function enqueueWebhookDelivery(projectId, emailId, event, data) {
  try {
    const { enqueueWebhookDeliveries } = await import("@calder/db");
    const { getDb } = await import("@calder/db");
    await enqueueWebhookDeliveries(getDb(), { projectId, event, data: { emailId, ...data } });
  } catch { /* best-effort */ }
}

