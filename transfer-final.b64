  cd /home/user/Calder && python3 -m pytest sdks/python/tests -q   # expect 16 passed
  rmdir /dev/null 2>/dev/null; rm -rf sdks/python/.pytest_cache

STEP 4 — remove the courier artifact from the index so it isn't committed:
  git rm --cached calder.patch 2>/dev/null; rm -f calder.patch

STEP 5 — push YOUR session branch and open the PR against main:
  git push -u origin arena/01a0d6fe-calder
