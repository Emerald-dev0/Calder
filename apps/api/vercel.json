{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter \"@calder/api...\" build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/v1/cron/drain",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/v1/cron/company-email",
      "schedule": "0 8 * * *"
    }
  ]
}
