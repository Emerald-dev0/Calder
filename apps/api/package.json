{
  "name": "@calder/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json && node scripts/bundle-serverless.mjs",
    "start": "node dist/src/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "launch-check": "tsx src/scripts/launch-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.600.0",
    "@calder/auth": "workspace:*",
    "@calder/billing": "workspace:*",
    "@calder/config": "workspace:*",
    "@calder/db": "workspace:*",
    "@calder/email": "workspace:*",
    "@calder/observability": "workspace:*",
    "@calder/providers": "workspace:*",
    "@calder/queue": "workspace:*",
    "@calder/rate-limit": "workspace:*",
    "@calder/validation": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "arctic": "^3.7.0",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.38.0",
    "drizzle-zod": "^0.5.1",
    "hono": "^4.6.0",
    "ioredis": "^6.0.0",
    "iron-session": "^9.0.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "esbuild": "^0.21.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}
